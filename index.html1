<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Dhiraj Pawar | 3D MASS 🔥</title>
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@800;900&family=Inter:wght@400;600;800&display=swap" rel="stylesheet">
<script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
<style>
*{margin:0;padding:0;box-sizing:border-box;font-family:'Inter',sans-serif;scroll-behavior:smooth}
body{background:#030014;color:#fff;overflow-x:hidden;perspective:1200px}
a{color:#fff;text-decoration:none}
#bg3d{position:fixed;inset:0;z-index:-1;opacity:.9}
nav{position:fixed;top:15px;left:50%;transform:translateX(-50%);width:94%;max-width:1150px;display:flex;justify-content:space-between;align-items:center;padding:14px 25px;background:rgba(255,255,255,.08);backdrop-filter:blur(20px);border:1px solid rgba(255,255,255,.2);border-radius:50px;z-index:100;animation:slideDown 1s ease}
@keyframes slideDown{from{transform:translate(-50%,-100px)}to{transform:translate(-50%,0)}}
.logo{font-family:'Poppins';font-size:26px;font-weight:900}.logo span{color:#c084fc}
nav .links a{margin-left:20px;font-weight:600;font-size:15px}
.hero{min-height:100vh;display:flex;align-items:center;justify-content:space-between;padding:140px 6% 50px;max-width:1250px;margin:auto;gap:30px;transform-style:preserve-3d}
.badge{background:linear-gradient(90deg,#a855f7,#ec4899);padding:10px 20px;border-radius:30px;font-weight:800;font-size:14px;display:inline-block;animation:bounce 2s infinite;box-shadow:0 0 30px #a855f7}
@keyframes bounce{0%,100%{transform:translateY(0)}50%{transform:translateY(-12px) scale(1.05)}}
.hero h1{font-family:'Poppins';font-size:76px;line-height:.95;font-weight:900;transform:translateZ(60px);text-shadow:0 10px 30px rgba(168,85,247,.6)}
.hero h1 span{background:linear-gradient(90deg,#c084fc,#f472b6,#facc15,#22d3ee,#c084fc);background-size:300% 300%;-webkit-background-clip:text;-webkit-text-fill-color:transparent;animation:grad 4s linear infinite}
@keyframes grad{to{background-position:300% 0}}
.typing{font-size:28px;font-weight:800;color:#facc15;height:40px;margin:14px 0;transform:translateZ(40px)}.typing:after{content:'|';animation:blink .8s infinite;color:#fff}
@keyframes blink{50%{opacity:0}}
.hero p{color:#cbd5e1;font-size:18px;line-height:1.6;max-width:550px;transform:translateZ(30px)}
.btn{padding:15px 30px;border-radius:50px;font-weight:800;display:inline-block;margin:8px 8px 0 0;font-size:16px;border:none;cursor:pointer;transition:.3s;transform:translateZ(20px)}
.btn1{background:linear-gradient(90deg,#a855f7,#ec4899);box-shadow:0 15px 35px #a855f766;color:#fff}.btn1:hover{transform:translateZ(40px) scale(1.12) rotate(-2deg)}
.btn2{background:rgba(255,255,255,.1);border:2px solid rgba(255,255,255,.3)}.btn2:hover{transform:translateZ(40px) scale(1.12) rotate(2deg);background:#fff;color:#000}
.btnCV{background:#facc15;color:#000}.btnCV:hover{transform:translateZ(40px) scale(1.12);box-shadow:0 0 35px #facc15}
.stats{display:flex;gap:30px;margin-top:30px}.stats b{font-size:30px;display:block}.stats span{color:#a1a1aa;font-size:13px}
.scene{flex:1;display:flex;flex-direction:column;align-items:center;gap:35px;transform-style:preserve-3d}
.photo-3d{width:300px;height:300px;position:relative;transform-style:preserve-3d;animation:floatY 5s ease-in-out infinite}
@keyframes floatY{0%,100%{transform:translateY(0) rotateY(0deg)}50%{transform:translateY(-18px) rotateY(8deg)}}
.photo-3d img{width:100%;height:100%;object-fit:cover;border-radius:30px;border:5px solid #fff;box-shadow:0 30px 60px rgba(168,85,247,.6);transform:translateZ(50px)}
.photo-3d:before{content:'';position:absolute;inset:15px;background:linear-gradient(135deg,#a855f7,#ec4899);border-radius:30px;transform:translateZ(-30px) rotate(6deg)}
.ring3d{position:absolute;width:340px;height:340px;border:3px dashed #c084fc;border-radius:50%;animation:spin3d 12s linear infinite;transform-style:preserve-3d;left:-20px;top:-20px}
@keyframes spin3d{from{transform:rotateX(70deg) rotateZ(0)}to{transform:rotateX(70deg) rotateZ(360deg)}}
.cube-wrap{width:140px;height:140px;perspective:800px}
.cube{width:100%;height:100%;position:relative;transform-style:preserve-3d;animation:cubeSpin 10s linear infinite}
@keyframes cubeSpin{from{transform:rotateX(-20deg) rotateY(0)}to{transform:rotateX(-20deg) rotateY(360deg)}}
.face{position:absolute;width:140px;height:140px;display:flex;align-items:center;justify-content:center;font-weight:900;font-size:18px;border:2px solid rgba(255,255,255,.4);border-radius:12px}
.f1{background:rgba(168,85,247,.85);transform:translateZ(70px)}
.f2{background:rgba(236,72,153,.85);transform:rotateY(90deg) translateZ(70px)}
.f3{background:rgba(250,204,21,.9);color:#000;transform:rotateY(180deg) translateZ(70px)}
.f4{background:rgba(34,211,238,.85);transform:rotateY(-90deg) translateZ(70px)}
.f5{background:rgba(255,255,255,.85);color:#000;transform:rotateX(90deg) translateZ(70px)}
.f6{background:rgba(0,0,0,.8);transform:rotateX(-90deg) translateZ(70px)}
.marquee{background:#facc15;color:#000;font-weight:900;padding:13px;white-space:nowrap;overflow:hidden;transform:rotate(-1.5deg) scale(1.02);font-size:20px;margin:20px 0}
.marquee span{display:inline-block;animation:scroll 12s linear infinite}
@keyframes scroll{from{transform:translateX(100vw)}to{transform:translateX(-100%)}}
.section{padding:85px 6%;max-width:1150px;margin:auto}
.section h2{font-family:'Poppins';font-size:46px}.sub{color:#a1a1aa;margin:8px 0 35px}
.grid{display:grid;grid-template-columns:1fr 1fr;gap:25px}
.flip{perspective:1000px;height:280px;cursor:pointer}
.flip-inner{position:relative;width:100%;height:100%;transform-style:preserve-3d;transition:transform .8s cubic-bezier(.4,0,.2,1)}
.flip:hover .flip-inner{transform:rotateY(180deg) scale(1.03)}
.flip-front,.flip-back{position:absolute;inset:0;backface-visibility:hidden;border-radius:28px;padding:30px;display:flex;flex-direction:column;justify-content:center;border:1px solid rgba(255,255,255,.15)}
.flip-front{background:linear-gradient(145deg,rgba(168,85,247,.25),rgba(255,255,255,.05))}
.flip-back{background:linear-gradient(145deg,#a855f7,#ec4899);transform:rotateY(180deg);text-align:center}
.flip-back h3{font-size:24px;margin-bottom:10px}.flip-back p{line-height:1.6}
.flip-front h3{font-size:24px;margin-bottom:12px}.flip-front p{color:#cbd5e1;line-height:1.6}
.tag{display:inline-block;background:rgba(255,255,255,.2);padding:7px 13px;border-radius:20px;font-size:12px;font-weight:700;margin:12px 5px 0 0}
.hint{margin-top:15px;color:#facc15;font-weight:800;font-size:13px}
.skill-card{background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.15);padding:30px;border-radius:26px;transform-style:preserve-3d;transition:.4s}
.skill-card:hover{transform:rotateX(6deg) rotateY(-6deg) translateY(-10px);box-shadow:0 30px 60px #a855f744}
.skill-bar{background:rgba(255,255,255,.12);height:14px;border-radius:20px;margin:10px 0 18px;overflow:hidden}
.skill-bar div{height:100%;background:linear-gradient(90deg,#a855f7,#ec4899,#facc15);animation:load 2.5s ease}
@keyframes load{from{width:0}}
.cv-box{background:linear-gradient(135deg,#a855f7,#ec4899,#f59e0b,#22d3ee);background-size:300% 300%;animation:grad 5s linear infinite;padding:50px;border-radius:30px;text-align:center;transform:rotate(-1deg);box-shadow:0 30px 60px #ec489955}
.cv-box a{background:#fff;color:#000;padding:16px 35px;border-radius:50px;font-weight:900;display:inline-block;margin-top:18px;font-size:18px}
input,textarea{width:100%;padding:15px;margin-bottom:13px;background:rgba(255,255,255,.1);border:1px solid rgba(255,255,255,.25);border-radius:15px;color:#fff;outline:none}
.reveal{opacity:0;transform:translateY(60px) rotateX(10deg);transition:1s}
.reveal.show{opacity:1;transform:none}
footer{text-align:center;padding:30px;color:#a1a1aa}
@media(max-width:800px){.hero{flex-direction:column-reverse;text-align:center}.hero h1{font-size:48px}.grid{grid-template-columns:1fr}nav .links{display:none}.photo-3d{width:230px;height:230px}.flip{height:300px}}
</style>
</head>
<body>
<canvas id="bg3d"></canvas>
<nav><div class="logo">Dhiraj<span>.dev</span> 🧊</div><div class="links"><a href="#about">About</a><a href="#skills">Skills</a><a href="#projects">Projects</a><a href="#cv">CV</a><a href="#contact">Contact</a></div></nav>

<div class="hero" id="hero">
<div id="heroText">
<div class="badge">✨ OPEN TO WORK • 3D MODE ON 🧊</div>
