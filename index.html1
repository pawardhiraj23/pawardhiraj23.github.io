<div class="flip"><div class="flip-inner"><div class="flip-front"><h3>🌐 3D Portfolio</h3><p>Hi website - 3D Cube, Flip, Parallax, 3D Background.</p><span class="tag">HTML</span><span class="tag">3D CSS</span><p class="hint">👉 Mouse ne - Mage bagh!</p></div><div class="flip-back"><h3>🌐 Details</h3><p>Tuch baghtoys! Ha 3D effect Three.js + CSS ne kelay.</p><p style="margin-top:10px;font-weight:800">😎 CHILL + MASS</p></div></div></div>
<div class="flip"><div class="flip-inner"><div class="flip-front"><h3>✅ To-Do App</h3><p>Simple, fast, clean task manager.</p><span class="tag">JS</span><span class="tag">UI/UX</span><p class="hint">👉 Mouse ne - Mage bagh!</p></div><div class="flip-back"><h3>✅ Details</h3><p>Add, Delete, Done - sagla Local Storage madhe save hotay.</p><p style="margin-top:10px;font-weight:800">⚡ SUPER FAST</p></div></div></div>
</div></div>

<div class="section reveal" id="cv"><h2>My CV 📄🧊</h2><p class="sub">3D Box madhe CV!</p><div class="cv-box"><h2 style="font-size:32px">Dhiraj Pawar - Resume</h2><p style="opacity:.9;margin-top:8px">BCS Student | Full Stack Developer | Pune</p><a href="https://github.com/pawardhiraj23" target="_blank">⬇️ DOWNLOAD MY CV 🎉</a></div></div>

<div class="section reveal" id="contact"><h2>Contact Me 📩</h2><p class="sub">Chai pe charcha karuya? ☕</p><div class="grid"><div class="skill-card"><h3>Message Kar 💬</h3><form onsubmit="alert('Thanks bro! Dhiraj lavkar reply deil 😎🔥');return false;"><input placeholder="Tuz Nav" required><input type="email" placeholder="Tuz Email" required><textarea rows="4" placeholder="Kay bolaychay?" required></textarea><button class="btn btn1" style="width:100%;border:none">Send Message 🚀</button></form></div><div class="skill-card" style="text-align:center;display:flex;flex-direction:column;justify-content:center"><h2 style="font-size:28px">Let's Connect! 🤝</h2><p style="margin:12px 0">Internship / Job / Freelance - DM kar.</p><p>📧 pawardhiraj123x@gmail.com</p><p>📍 Pimpri, Pune</p><p>🐙 GitHub: pawardhiraj23</p></div></div></div>

<footer>Made with 💜🧊 by Dhiraj Pawar • © 2026 • Stay 3D, Stay Chill 😎</footer>

<script>
// Typing
const words=["Full Stack Developer 💻","3D Designer 🧊","ML Engineer 🤖","Chill Coder 😎","Future CTO 🚀"];
let wi=0,ci=0,del=false;const el=document.getElementById('typing');
function type(){let w=words[wi];el.textContent=w.slice(0,ci);if(!del){ci++;if(ci>w.length){del=true;setTimeout(type,1200);return}}else{ci--;if(ci==0){del=false;wi=(wi+1)%words.length}}setTimeout(type,del?40:90)}type();
// 3D Parallax
const hero=document.getElementById('hero'),txt=document.getElementById('heroText'),scene=document.getElementById('scene'),photo=document.getElementById('photo3d');
hero.addEventListener('mousemove',e=>{let x=(e.clientX/innerWidth-.5),y=(e.clientY/innerHeight-.5);txt.style.transform=`translate(${x*20}px,${y*15}px)`;scene.style.transform=`translate(${x*-25}px,${y*-20}px)`;photo.style.transform=`rotateY(${x*20}deg) rotateX(${-y*15}deg)`});
hero.addEventListener('mouseleave',()=>{txt.style.transform='';scene.style.transform='';photo.style.transform=''});
// Reveal
const obs=new IntersectionObserver(es=>es.forEach(e=>{if(e.isIntersecting)e.target.classList.add('show')}),{threshold:.15});
document.querySelectorAll('.reveal').forEach(e=>obs.observe(e));
// Mobile Flip
document.querySelectorAll('.flip').forEach(f=>f.addEventListener('click',()=>{let inn=f.querySelector('.flip-inner');inn.style.transform=inn.style.transform.includes('180')?'':'rotateY(180deg)'}));
</script>

<script>
// ===== 3D BACKGROUND 🔥 =====
const canvas = document.getElementById('bg3d');
const scene3 = new THREE.Scene();
const camera = new THREE.PerspectiveCamera(75, innerWidth/innerHeight, 0.1, 1000);
const renderer = new THREE.WebGLRenderer({canvas: canvas, alpha: true});
renderer.setSize(innerWidth, innerHeight);
camera.position.z = 8;
const torus = new THREE.Mesh(new THREE.TorusGeometry(2.5,0.3,16,100), new THREE.MeshBasicMaterial({color:0xa855f7,wireframe:true}));
torus.position.x=-4; torus.position.y=1; scene3.add(torus);
const cube3 = new THREE.Mesh(new THREE.BoxGeometry(1.5,1.5,1.5), new THREE.MeshBasicMaterial({color:0xec4899,wireframe:true}));
cube3.position.x=4; cube3.position.y=-1.5; scene3.add(cube3);
const sph = new THREE.Mesh(new THREE.SphereGeometry(1,20,20), new THREE.MeshBasicMaterial({color:0x22d3ee,wireframe:true}));
sph.position.x=3.5; sph.position.y=2.5; scene3.add(sph);
const starGeo = new THREE.BufferGeometry();
const starCount=400; const pos=new Float32Array(starCount*3);
for(let i=0;i<starCount*3;i++){pos[i]=(Math.random()-0.5)*25;}
starGeo.setAttribute('position', new THREE.BufferAttribute(pos,3));
const stars = new THREE.Points(starGeo, new THREE.PointsMaterial({color:0xfacc15,size:0.06}));
scene3.add(stars);
let mx=0,my=0;
document.addEventListener('mousemove',e=>{mx=(e.clientX/innerWidth-0.5)*2; my=(e.clientY/innerHeight-0.5)*2;});
function animate(){requestAnimationFrame(animate); torus.rotation.x+=0.01; torus.rotation.y+=0.01; cube3.rotation.x+=0.02; cube3.rotation.y+=0.02; sph.rotation.y+=0.015; stars.rotation.y+=0.001; camera.position.x=mx*0.8; camera.position.y=-my*0.8; camera.lookAt(0,0,0); renderer.render(scene3,camera);}
animate();
addEventListener('resize',()=>{camera.aspect=innerWidth/innerHeight; camera.updateProjectionMatrix(); renderer.setSize(innerWidth,innerHeight);});
</script>
</body>
</html>
